      <rdf:Description rdf:about=""
            xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/">
         <xmpMM:DocumentID>uuid:b6fa2d07-4ea6-407e-bfed-a9316d25043b</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:95337947-1dd1-11b2-0a00-9000b813babf</xmpMM:InstanceID>
